# Meta / Messenger
PAGE_ACCESS_TOKEN=your_page_access_token_here
WEBHOOK_VERIFY_TOKEN=pick_your_own_random_string_here
APP_SECRET=your_meta_app_secret_here

# Claude (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server
PORT=3000
NODE_ENV=development
REQUEST_TIMEOUT_MS=10000
QUEUE_MAX_SIZE=100
QUEUE_CONCURRENCY=3
SHUTDOWN_TIMEOUT_MS=30000

# Roles
# Set your Messenger PSID here to automatically become the 👑 OWNER
OWNER_PSID=your_psid_here

# Logging (optional — safe to leave unset)
LOG_LEVEL=info
LOG_COLOR=true
